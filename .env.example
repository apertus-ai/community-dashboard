# Optional — the dashboard works with zero configuration.
# Tokens only lift API rate limits; they never gate data.
# Copy this file to .env and fill in what you have.

# Hugging Face token — fine-grained, "read public" access is enough.
# https://huggingface.co/settings/tokens
VITE_HF_TOKEN=

# GitHub fine-grained personal access token with no extra scopes.
# Lifts the unauthenticated 60 req/hour limit to 5,000/hour.
# https://github.com/settings/personal-access-tokens
VITE_GITHUB_TOKEN=
